# Copy to .env and adjust. Never commit the real .env.

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/llmlogs

# mock = no API key needed, runs fully offline.
# openrouter = real completions, requires OPENROUTER_API_KEY.
LLM_PROVIDER=mock
LLM_MODEL=mock/echo-1

# OPENROUTER_API_KEY=sk-or-...
# LLM_PROVIDER=openrouter
# LLM_MODEL=anthropic/claude-3.5-sonnet

INGEST_URL=http://127.0.0.1:8000/ingest
HISTORY_TURN_LIMIT=20
PREVIEW_MAX_CHARS=500
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Anthropic (native Messages API, not via OpenRouter)
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_API_KEY=sk-ant-...
